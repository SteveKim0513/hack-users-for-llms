{
  "description": "위임 전 기준 점검(명령 훅, criteria-init으로 켠 곳에서만)과 /compass mod(목표 진척과 빈 곳 질문, /compass로 목표를 정한 세션에서만). 꺼져 있으면 아무것도 하지 않는다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/criteria-hook.sh"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./compass.tsx"
  ]
}

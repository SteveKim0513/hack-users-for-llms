{
  "description": "위임 전 기준 점검(명령 훅)과 mod(/compass, 기준 공백 점검). 기준 점검은 criteria-init으로 켠 곳에서만 동작하고, 꺼져 있으면 아무것도 하지 않는다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/criteria-hook.sh"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
